---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.astro';
import { archiveUrl } from '../data/site';
import showcase from '../assets/personal-designer-rs.png';
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Rick Blom / a personal space</p>
      <h1 id="hero-heading">A curious mind.<br />A builder's hands.<br /><em>An open lens.</em></h1>
      <p class="intro">Some ideas become software. Others become photographs.<br class="desktop-break" /> This is where my curiosity finds a home.</p>
      <a class="button" href="#explore">Take a look around <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-grid"></div>
      <span class="art-label art-top">FIELD NOTES / 001</span>
      <div class="orbital orbital-one"></div>
      <div class="orbital orbital-two"></div>
      <div class="lens-core"><span>rb<span class="lens-period">.</span></span></div>
      <span class="art-coordinate">CODE + CURIOSITY + PERSPECTIVE</span>
      <span class="art-label art-bottom">Always a work in progress ↗</span>
    </div>
  </section>

  <div class="ticker" aria-label="Code. Create. Observe. Repeat.">
    <div class="wrap ticker-inner"><span>Code</span><i aria-hidden="true">✳</i><span>Create</span><i aria-hidden="true">✳</i><span>Observe</span><i aria-hidden="true">✳</i><span>Repeat</span><i aria-hidden="true">✳</i></div>
  </div>

  <section class="work-section wrap" id="explore" aria-labelledby="explore-heading">
    <div class="section-heading">
      <div><p class="eyebrow">Two sides of the same curiosity</p><h2 id="explore-heading">Making things.<br /><em>Seeing differently.</em></h2></div>
      <p>One space for building something from scratch.<br />Another for noticing what's already there.</p>
    </div>
    <article class="project-card">
      <div class="project-copy">
        <p class="eyebrow">01 / Things I build</p>
        <div class="tags"><span>Rust</span><span>CAD</span><span>Hobby project</span></div>
        <h3>PersonalDesigner<span class="accent">RS</span></h3>
        <p>A little nostalgia. A lot of curiosity. An engineering and design platform built in Rust, inspired by the CAD tools that started it all.</p>
        <p class="muted">Not a finished product. A project worth exploring.</p>
        <a class="text-link" href="/projects/personal-designer-rs/">Step inside the project <span aria-hidden="true">↗</span></a>
      </div>
      <a class="project-image" href="/projects/personal-designer-rs/" aria-label="Explore PersonalDesignerRS">
        <div class="window-label"><span class="window-dots" aria-hidden="true">● ● ●</span><span>PersonalDesignerRS / engineering workspace</span></div>
        <Image src={showcase} alt="PersonalDesignerRS showing an engineering grid, solid boxes, object tree and command prompt." widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 55vw" format="webp" loading="lazy" />
        <span class="image-caption">A real workspace. Built one step at a time.</span>
      </a>
    </article>
    <article class="photo-card">
      <div class="photo-illustration" aria-hidden="true">
        <div class="viewfinder"><span class="crosshair"></span><span class="frame-number">FRAME / NEXT</span><span class="frame-note">ROOM FOR A DIFFERENT PERSPECTIVE</span></div>
        <span class="illustration-note">A space for photographs, not stock imagery.</span>
      </div>
      <div class="photo-copy">
        <p class="eyebrow">02 / Things I see</p>
        <h3>A different<br /><em>kind of focus.</em></h3>
        <p>Away from the code, behind the camera. A place for my photography, and for the details that deserve a second look.</p>
        <p class="muted">The first photographs are still to come.</p>
        <a class="text-link" href="/photography/">Explore the photography space <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  </section>

  <section class="about-band" aria-labelledby="about-heading">
    <div class="wrap about-inner">
      <p class="eyebrow">The thread that connects it all</p>
      <h2 id="about-heading">It's not about having<br />all the answers.<br /><em>It's about staying curious.</em></h2>
      <div>
        <p>I'm Rick. This is my space outside the everyday: a home for a hands-on engineering project, photography, and whatever the next interesting idea might be.</p>
        <p>Some things here are polished. Others are experiments. That's part of the fun.</p>
        {archiveUrl && <a class="text-link" href={archiveUrl}>From the archives: Dynamics NAV Tips &amp; Tricks <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </section>
  <Connect />
</Base>
